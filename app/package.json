{
  "name": "leadguard",
  "version": "0.2.0",
  "private": true,
  "description": "LeadGuard: trustworthy check-ins and sponsor leads",
  "main": "src/server.js",
  "scripts": {
    "start": "node --require @opentelemetry/auto-instrumentations-node/register src/server.js",
