    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "express": "^5.3.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.65.0"
  }
}
